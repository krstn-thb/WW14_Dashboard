# Nur notwendig, wenn InfluxDB aktiviert wird.
INFLUXDB_ENABLED=false
INFLUXDB_URL=https://YOUR-INFLUXDB-CLOUD-HOST
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=your-bucket
INFLUXDB_TOKEN=hier-token-eintragen

# Optional: Zieladresse des Kiosk-Browsers.
DASHBOARD_URL=http://127.0.0.1:8080

# Optional: anderes Zertifikat der internen CA für SensoBuild, falls es erneuert wurde.
# SENSOBUILD_CA_BUNDLE=/home/pi/certs/interne-ca.pem

