[Unit]
Description=WW14 Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@PROJECT_DIR@@
EnvironmentFile=-@@PROJECT_DIR@@/.env
ExecStart=@@PROJECT_DIR@@/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

